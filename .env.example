NEXT_PUBLIC_SITE_URL=http://localhost:42486
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
R2_PUBLIC_BASE_URL=https://fenjue-images.akko.space

# Server-only R2 write credentials. Never expose these to the browser or commit them.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Resend SMTP is configured in Supabase Auth, never in this public app env file.
