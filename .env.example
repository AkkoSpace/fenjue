NEXT_PUBLIC_SITE_URL=http://localhost:42486
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
R2_PUBLIC_BASE_URL=https://fenjue-images.akko.space

# Trusted scheduled jobs only. Prefer the new sb_secret_ key; the legacy
# SUPABASE_SERVICE_ROLE_KEY is also supported. Never expose either to browsers.
SUPABASE_SECRET_KEY=sb_secret_your_key
CRON_SECRET=replace_with_a_long_random_value

# Server-only R2 write credentials. Never expose these to the browser or commit them.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Private analytics archive bucket. It must not be R2_BUCKET_NAME because that
# bucket is publicly readable through R2_PUBLIC_BASE_URL. Dedicated credentials
# are recommended; account ID and credentials fall back to the image values when
# the same token has access to both buckets.
R2_ANALYTICS_ACCOUNT_ID=your_cloudflare_account_id
R2_ANALYTICS_ACCESS_KEY_ID=your_analytics_r2_access_key_id
R2_ANALYTICS_SECRET_ACCESS_KEY=your_analytics_r2_secret_access_key
R2_ANALYTICS_BUCKET_NAME=your_private_analytics_bucket_name

ANALYTICS_HOT_RETENTION_DAYS=180
ANALYTICS_ARCHIVE_BATCH_SIZE=10000

# Resend SMTP is configured in Supabase Auth, never in this public app env file.
